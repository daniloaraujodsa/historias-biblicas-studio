# Porta do servidor (padrão 8765)
# PORT=8765

# --- Imagens IA ---
# Auto (IMAGE_PROVIDER vazio ou "auto"):
#   XAI_API_KEY → grok | OPENAI_API_KEY → openai | senão → pollinations
# Em falha: Grok/OpenAI → Pollinations → placeholder Pillow.

# Recomendado: xAI Grok Imagine (sem secret real neste arquivo)
# XAI_API_KEY=xai-...
# GROK_IMAGE_MODEL=grok-imagine-image-2.0
# Alternativa: grok-imagine-image-quality

# Opcional: OpenAI Images API
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=dall-e-3

# Forçar provedor: grok | openai | pollinations | placeholder | auto
# IMAGE_PROVIDER=grok

# Endpoint legado Pollinations (sem API key)
# POLLINATIONS_BASE=https://image.pollinations.ai/prompt

# Timeout e retries (fila anônima do Pollinations pode retornar 429)
# IMAGE_TIMEOUT_SEC=120
# IMAGE_MAX_RETRIES=4

# --- Fidelidade de personagens ---
# Com XAI_API_KEY + imagem de referência em data/projects/<id>/characters/,
# a geração usa POST /v1/images/edits (refs em data URI). Sem ref: bible no prompt.
# Pollinations/OpenAI: apenas texto da bible (sem image edit).
